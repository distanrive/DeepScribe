# DeepScribe 配置文件
# 复制为 .env 并填入实际值，.env 已被 gitignore 排除

# ============================================================
# DeepSeek API（必填）
# ============================================================
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ============================================================
# 翻译参数
# ============================================================
# API 响应 max_tokens（输出上限，不是上下文窗口）
# 默认 65536；设太高可能超出模型输出限制导致报错
MAX_TOKENS=65536
# 温度，0.0-1.0，学术翻译建议 0.3
TRANSLATE_TEMP=0.3
# DeepSeek 思考模式（额外 token 消耗）
USE_THINKING=false
REASONING_EFFORT=high

# ============================================================
# Token 感知分块
# ============================================================
# 每次 API 调用目标 token 数（输入侧），实际受 MAX_TOKENS//2 钳制
TARGET_TOKENS_PER_CALL=30000
# 每次调用段落硬上限
MAX_PARAS_PER_CALL=120
# marker 保留率阈值：低于此值自动缩小分块，设为 1.0 禁用自适应
MIN_MARKER_RETENTION=0.95

# ============================================================
# MinerU PDF 解析
# ============================================================
# 解析后端：pipeline（快速稳定，CPU/GPU 均可）
# hybrid-engine（混合引擎，高精度，需 GPU）| vlm-engine（纯 VLM 引擎，需 GPU）
# hybrid-http-client / vlm-http-client（HTTP 客户端模式）
MINERU_BACKEND=pipeline
# hybrid-engine 后端解析强度：medium（更快，默认）| high（更准，含 image analysis）
MINERU_EFFORT=medium
# 单次解析超时（秒），大文件适当调大
MINERU_TIMEOUT=1800

# ============================================================
# 并行翻译
# ============================================================
# 启用后，若 PDF 含多级书签则按章节并行翻译；无书签自动退回串行
ENABLE_PARALLEL=false
# 最大并发线程数（受 API rate limit 约束）
MAX_PARALLEL_WORKERS=4
# MinerU 阶段最大并发数（1=串行，安全稳定；2-3 需足够显存）
# hybrid-engine 每实例约 2-3 GB 显存，8 GB 显卡建议 ≤ 2
MAX_PARALLEL_MINERU=1
# 大章二次拆分阈值（页数）。某章超过此页数时自动用二级书签进一步拆分。
# 设为 0 禁用；建议 80-120，视 GPU 显存和翻译 chunk 大小调整。
MAX_CHAPTER_PAGES=100

# ============================================================
# 完整性校验
# ============================================================
# 检测译文行内公式/代码是否被 LLM 损坏，损坏则回填原文（零额外 API）
ENABLE_INTEGRITY=true
